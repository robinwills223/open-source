# Environment Configuration for Django Small Tool
# Copy this file to .env before running the server:
# cp .env.example .env

# SECURITY WARNING: Keep DEBUG=False in production. Set to True only for local development.
DEBUG=True

# Secret key for cryptographic signing.
# In local development with DEBUG=True, a fallback development key is used if left blank.
# In production (DEBUG=False), this MUST be set to a secure, random string (e.g. 50+ characters).
SECRET_KEY=

# Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Optional: Path to SQLite database file. Defaults to 'db.sqlite3' in project root.
# Set this to a persistent volume path when deploying on persistent container hosts (e.g. /data/db.sqlite3).
# DJANGO_DB_PATH=/data/db.sqlite3

# Optional: SSL / HTTPS redirect. Set to True in production behind HTTPS.
SECURE_SSL_REDIRECT=False
